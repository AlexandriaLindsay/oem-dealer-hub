APP_NAME=DealerDock
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8010

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The privacy policy and terms. Bump the version when either text changes in a
# way people should agree to again (everyone is asked at their next sign-in).
# Set REVIEWED=true only once a lawyer has reviewed them (removes the "draft" notice).
DEALERDOCK_TERMS_VERSION=2026-11-11.2
DEALERDOCK_LEGAL_REVIEWED=false
DEALERDOCK_COMPANY_NAME=
DEALERDOCK_COMPANY_ADDRESS=
DEALERDOCK_CONTACT_EMAIL=
DEALERDOCK_GOVERNING_LAW=

# Cloudflare Turnstile (bot check on sign-up, sign-in, password reset).
# Leave empty locally to skip it; production requires both. Cloudflare's test
# keys (always pass): 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Billing (Stripe, through Laravel Cashier). Test-mode keys from the Stripe
# dashboard -> Developers -> API keys. Leave empty and billing shows as "not set up".
STRIPE_KEY=
STRIPE_SECRET=
# From "stripe listen" locally, or the webhook endpoint's signing secret in production (required there).
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd
# One price per plan and period (Product catalog). Amounts must match App\Support\Plan.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# Uploaded documents: a private disk locally, object storage in production.
DEALERDOCK_DOCUMENTS_DISK=documents
# Where the local documents disk keeps files (default: storage/app/private/documents).
# Set it for a second copy of the app so its files stay apart from yours.
DEALERDOCK_DOCUMENTS_ROOT=
# Library uploads (manuals, parts books), in KB. Keep PHP's upload limits and clamd's StreamMaxLength at least this big.
DEALERDOCK_LIBRARY_MAX_KB=40960
# Malware scanning of uploads: "clamav" (production) or "none" (local only).
DEALERDOCK_SCANNER=none
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
